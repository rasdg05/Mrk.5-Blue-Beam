# =============================================================================
# App
# =============================================================================
# Public base URL of the app (used to build payment return URLs / webhook URLs).
APP_URL="http://localhost:3000"
NODE_ENV="development"

# =============================================================================
# Database (Postgres)
# =============================================================================
# A live Postgres is required. Use the provided docker-compose for local dev.
DATABASE_URL="postgresql://autos:autos@localhost:5432/autos?schema=public"

# =============================================================================
# Auth (admin session signing)
# =============================================================================
# 32+ char random secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Cron endpoints are protected by a shared secret (Bearer token).
CRON_SECRET="change-me-cron-secret"

# =============================================================================
# Mercado Pago (México)  — https://www.mercadopago.com.mx/developers
# =============================================================================
# Use TEST credentials in development.
MERCADOPAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000"
# Secret used to validate the x-signature header on incoming webhooks.
MERCADOPAGO_WEBHOOK_SECRET="your-mp-webhook-secret"

# =============================================================================
# Crypto gateway (Phase 2 — NOWPayments shown as the fast fallback)
# =============================================================================
CRYPTO_PROVIDER="nowpayments"
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# =============================================================================
# Email (Resend)
# =============================================================================
RESEND_API_KEY=""
EMAIL_FROM="Autos MX <no-reply@example.com>"
# Where operator/admin notifications are sent.
ADMIN_NOTIFICATION_EMAIL="ops@example.com"

# =============================================================================
# Image storage (Cloudinary) — used by the admin uploader (Phase 1 stores URLs)
# =============================================================================
# Cloud name + an UNSIGNED upload preset enable the in-panel "Subir fotos" button.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
# API key/secret are only needed for signed/server-side operations (later phases).
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
